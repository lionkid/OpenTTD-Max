// OpenTTD-Max Aviation. Assembled into build/max-air.nml by tools/gen_nml.py.
grf {
    grfid: "MAX\01";
    name: string(STR_GRF_AIR_NAME);
    desc: string(STR_GRF_AIR_DESC);
    url: string(STR_GRF_URL);
    version: @VERSION@;
    min_compatible_version: 1;
    param 0 {
        param_disable_default_aircraft {
            name: string(STR_PARAM_DISABLE_AIRCRAFT_NAME);
            desc: string(STR_PARAM_DISABLE_AIRCRAFT_DESC);
            type: bool;
            def_value: 0;
        }
    }
    param 1 {
        param_loading {
            name: string(STR_PARAM_LOADING_NAME);
            desc: string(STR_PARAM_LOADING_DESC);
            type: int;
            min_value: 0;
            max_value: 3;
            def_value: 0;
            names: {
                0: string(STR_PARAM_LOADING_STANDARD);
                1: string(STR_PARAM_LOADING_FAST);
                2: string(STR_PARAM_LOADING_VERY_FAST);
                3: string(STR_PARAM_LOADING_ORIGINAL);
            };
        }
    }
    param 2 {
        param_sounds {
            name: string(STR_PARAM_SOUNDS_NAME);
            desc: string(STR_PARAM_SOUNDS_DESC);
            type: int;
            min_value: 0;
            max_value: 1;
            def_value: 0;
            names: {
                0: string(STR_PARAM_SOUNDS_SET);
                1: string(STR_PARAM_SOUNDS_ORIGINAL);
            };
        }
    }
    param 3 {
        param_aging {
            name: string(STR_PARAM_AGING_NAME);
            desc: string(STR_PARAM_AGING_DESC);
            type: int;
            min_value: 0;
            max_value: 1;
            def_value: 0;
            names: {
                0: string(STR_PARAM_AGING_ON);
                1: string(STR_PARAM_AGING_OFF);
            };
        }
    }
}

// Cargo labels used by the cabin-layout callbacks (cargo_type_in_veh).
cargotable { PASS, MAIL }

// Optional: hide the original aircraft so only this set is on sale.
if (param_disable_default_aircraft) {
    disable_item(FEAT_AIRCRAFT);
}

#include "common/templates.pnml"
#if BADGES
#include "common/badges.pnml"
#endif
#include "generated/air_items.pnml"
