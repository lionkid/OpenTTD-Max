// OpenTTD-Max High-Speed Rail. Assembled into build/max-rail.nml by tools/gen_nml.py.
grf {
    grfid: "MAX\02";
    name: string(STR_GRF_RAIL_NAME);
    desc: string(STR_GRF_RAIL_DESC);
    url: string(STR_GRF_URL);
    version: @VERSION@;
    min_compatible_version: 1;
    param 0 {
        param_disable_default_maglev {
            name: string(STR_PARAM_DISABLE_MAGLEV_NAME);
            desc: string(STR_PARAM_DISABLE_MAGLEV_DESC);
            type: bool;
            def_value: 0;
        }
    }
    param 1 {
        param_loading {
            name: string(STR_PARAM_LOADING_NAME);
            desc: string(STR_PARAM_LOADING_DESC);
            type: int;
            min_value: 0;
            max_value: 3;
            def_value: 0;
            names: {
                0: string(STR_PARAM_LOADING_STANDARD);
                1: string(STR_PARAM_LOADING_FAST);
                2: string(STR_PARAM_LOADING_VERY_FAST);
                3: string(STR_PARAM_LOADING_ORIGINAL);
            };
        }
    }
    param 2 {
        param_sounds {
            name: string(STR_PARAM_SOUNDS_NAME);
            desc: string(STR_PARAM_SOUNDS_DESC);
            type: int;
            min_value: 0;
            max_value: 1;
            def_value: 0;
            names: {
                0: string(STR_PARAM_SOUNDS_SET);
                1: string(STR_PARAM_SOUNDS_ORIGINAL);
            };
        }
    }
    param 3 {
        param_formation {
            name: string(STR_PARAM_FORMATION_NAME);
            desc: string(STR_PARAM_FORMATION_DESC);
            type: int;
            min_value: 0;
            max_value: 2;
            def_value: 0;
            names: {
                0: string(STR_PARAM_FORMATION_BOTH);
                1: string(STR_PARAM_FORMATION_FIXED);
                2: string(STR_PARAM_FORMATION_FREE);
            };
        }
    }
}

// Optional: hide the original maglev locomotives (engines 84-88: Lev1-Lev4, Wizzowow Rocketeer).
// Maglev wagons stay, and the maglev railtype is still introduced by Transrapid SMT (2004).
if (param_disable_default_maglev) {
    disable_item(FEAT_TRAINS, 84, 88);
}

#include "common/templates.pnml"
#include "common/railtypes.pnml"
#if BADGES
#include "common/badges.pnml"
#endif
#include "generated/rail_items.pnml"
